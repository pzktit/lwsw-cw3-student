#!/bin/bash

# Function to display usage instructions
usage() {
    echo "Usage: $0 <input_markdown_file>"
    exit 1
}

# Check if the input argument is provided
if [ "$#" -ne 1 ]; then
    usage
fi

# Get the input filename from the argument
input_file="$1"

# Check if the input file exists
if [ ! -f "$input_file" ]; then
    echo "Error: File '$input_file' not found!"
    exit 1
fi

# Check if the input file has a .md extension
if [[ "$input_file" != *.md ]]; then
    echo "Error: Input file must be a Markdown (.md) file."
    exit 1
fi

# Get the filename without the extension
base_name="${input_file%.md}"

# Set the output filenames
html_file="${base_name}.html"
pdf_file="${base_name}.pdf"

# Convert Markdown to HTML using Pandoc
pandoc "$input_file" -o "$html_file"

# Convert HTML to PDF using wkhtmltopdf
wkhtmltopdf --encoding 'utf-8' --allow . "$html_file" "$pdf_file"

echo "Conversion done. Check for file files:"
echo "HTML: $html_file"
echo "PDF: $pdf_file"
